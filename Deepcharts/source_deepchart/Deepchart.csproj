<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>Deepchart</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="StubServer.StubDecryptor" />
    <None Remove="LiteralStub.StubEditor" />
    <None Remove="RandomStub.StubStream" />
    <None Remove="StubSingleton.InspectorTracer" />
    <None Remove="OrderedStub.CommonStub" />
    <EmbeddedResource Include="StubServer.StubDecryptor" LogicalName="StubServer.StubDecryptor" />
    <EmbeddedResource Include="LiteralStub.StubEditor" LogicalName="LiteralStub.StubEditor" />
    <EmbeddedResource Include="RandomStub.StubStream" LogicalName="RandomStub.StubStream" />
    <EmbeddedResource Include="StubSingleton.InspectorTracer" LogicalName="StubSingleton.InspectorTracer" />
    <EmbeddedResource Include="OrderedStub.CommonStub" LogicalName="OrderedStub.CommonStub" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="System.Configuration.ConfigurationManager" />
    <Reference Include="System.Windows.Extensions" />
    <PackageReference Include="RestSharp" Version="*" />
    <PackageReference Include="SharpDX.Mathematics" Version="*" />
    <PackageReference Include="System.IO.Packaging" Version="*" />
    <PackageReference Include="Flee" Version="*" />
    <PackageReference Include="System.Drawing.Common" Version="*" />
    <PackageReference Include="protobuf-net.Core" Version="*" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="*" />
    <PackageReference Include="protobuf-net" Version="*" />
    <PackageReference Include="Nager.Date" Version="*" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="*" />
    <PackageReference Include="System.Management" Version="*" />
    <PackageReference Include="SharpDX.Direct2D1" Version="*" />
    <PackageReference Include="SharpDX" Version="*" />
    <PackageReference Include="ZstdSharp.Port" Version="*" />
    <PackageReference Include="SharpDX.DXGI" Version="*" />
  </ItemGroup>
</Project>